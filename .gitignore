# ============================================================
# Data files — by default, all data is distributed via Zenodo,
# not tracked in Git. Per-figure inputs are whitelisted below.
# ============================================================

# Tabular data
*.csv
*.tsv

# Binary / serialized data
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.h5ad
*.hdf5
*.loom

# Image data
*.tiff
*.tif
*.ome.tif

# ============================================================
# Figure outputs — never tracked
# ============================================================
*.png
*.jpg
*.jpeg
*.pdf
*.eps
*.eps2

# Note: *.svg is intentionally NOT globbed here. Schematic SVGs
# checked into the repo (e.g. figure_6_panel_d_msm_schematic.svg)
# are the only authoritative source for the panel and must be
# tracked. Generated SVGs land in per-figure output/ directories,
# which are ignored further down.

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
.env

# Jupyter / Marimo notebook checkpoints
.ipynb_checkpoints/
__marimo__/

# ============================================================
# System / IDE
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ============================================================
# Output directories — never tracked
# ============================================================
output/
outputs/

# ============================================================
# Whitelist: per-figure bundled input data
# (Anything under figures/figure_<n>/data/ is in scope unless
# re-ignored below for size or licensing reasons.)
# ============================================================
!figures/figure_2/data/
!figures/figure_2/data/**
!figures/figure_3/data/
!figures/figure_3/data/**
!figures/figure_4/data/
!figures/figure_4/data/**
!figures/figure_5/data/
!figures/figure_5/data/**
!figures/figure_6/data/
!figures/figure_6/data/**

# ============================================================
# Re-ignore: files >100 MB that would require Git LFS.
# These remain in the working tree but are downloaded from
# Zenodo rather than tracked here.
# ============================================================
figures/figure_2/data/abm_window_info_and_averages.csv
figures/figure_2/data/abm_windows_clustered_with_state_label.csv
figures/figure_3/data/mibi_roi_poisson_anndata.pkl
figures/figure_6/data/abm_windows_clustered_with_state_label.csv
